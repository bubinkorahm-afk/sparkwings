# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# ─── Database (Neon Postgres) ─────────────────────────────────────
# Added automatically when you connect Neon from the Vercel Marketplace.
# Leave unset locally to use the embedded dev database in ./.data/pglite.
DATABASE_URL=

# ─── Admin console (/admin) ───────────────────────────────────────
# Changing ADMIN_PASSWORD signs everyone out.
ADMIN_PASSWORD=
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ─── Odoo CRM (leads → crm.lead) ──────────────────────────────────
# If unset, leads are still saved to the database (or logged) and marked "Not sent".
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# ─── Analytics (loaded only after cookie consent) ─────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
